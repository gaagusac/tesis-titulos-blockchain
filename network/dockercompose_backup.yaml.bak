version: '3.7'

volumes:
  orderer.usac.edu.gt:
  peer0.ingenieria.usac.edu.gt:
  couchdb0:
  ipfs_data:

networks:
  red-usac:
    name: red-usac

services:
  # 1. Base de datos de Estado Mundial (World State - CouchDB)
  # couchdb0:
  #   container_name: couchdb0
  #   image: hyperledger/fabric-couchdb:0.4.22
  #   environment:
  #       - COUCHDB_USER=admin
  #       - COUCHDB_PASSWORD=adminpw
  #   ports:
  #     - "5984:5984"
  #   networks:
  #     - red-usac

  # 2. Nodo Ordenador (Orderer - Raft Consensus)
  orderer.usac.edu.gt:
    container_name: orderer.usac.edu.gt
    image: hyperledger/fabric-orderer:2.5.4
    environment:
      - FABRIC_LOGGING_SPEC=INFO
      - ORDERER_GENERAL_LISTENADDRESS=0.0.0.0
      - ORDERER_GENERAL_LISTENPORT=7050
      - ORDERER_GENERAL_GENESISMETHOD=file
      - ORDERER_GENERAL_GENESISFILE=/var/hyperledger/orderer/orderer.genesis.block
      - ORDERER_GENERAL_LOCALMSPID=OrdererMSP
      - ORDERER_GENERAL_LOCALMSPDIR=/var/hyperledger/orderer/msp

      - ORDERER_GENERAL_TLS_ENABLED=true
      - ORDERER_GENERAL_TLS_PRIVATEKEY=/var/hyperledger/orderer/tls/server.key
      - ORDERER_GENERAL_TLS_CERTIFICATE=/var/hyperledger/orderer/tls/server.crt
      - ORDERER_GENERAL_TLS_ROOTCAS=[/var/hyperledger/orderer/tls/ca.crt]
      - ORDERER_GENERAL_CLUSTER_CLIENTCERTIFICATE=/var/hyperledger/orderer/tls/server.crt
      - ORDERER_GENERAL_CLUSTER_CLIENTPRIVATEKEY=/var/hyperledger/orderer/tls/server.key
      - ORDERER_GENERAL_CLUSTER_CLIENTROOTCAS=[/var/hyperledger/orderer/tls/ca.crt]

    working_dir: /opt/gopath/src/github.com/hyperledger/fabric
    command: orderer
    volumes:
      - ./channel-artifacts/genesis.block:/var/hyperledger/orderer/orderer.genesis.block
      - ./crypto-config/ordererOrganizations/usac.edu.gt/orderers/orderer.usac.edu.gt/msp:/var/hyperledger/orderer/msp
      - ./crypto-config/ordererOrganizations/usac.edu.gt/orderers/orderer.usac.edu.gt/tls:/var/hyperledger/orderer/tls
      - orderer.usac.edu.gt:/var/hyperledger/production/orderer
    ports:
      - "7050:7050"
    networks:
      - red-usac

  # 3. Nodo Validador / Endorser (Peer - Facultad de Ingeniería)
  peer0.ingenieria.usac.edu.gt:
    container_name: peer0.ingenieria.usac.edu.gt
    image: hyperledger/fabric-peer:2.5.4
    environment:
      - CORE_VM_ENDPOINT=unix:///host/var/run/docker.sock
      - CORE_VM_DOCKER_HOSTCONFIG_NETWORKMODE=red-usac
      - FABRIC_LOGGING_SPEC=INFO

      - CORE_PEER_TLS_ENABLED=false
      - CORE_PEER_PROFILE_ENABLED=true
      - CORE_PEER_ID=peer0.ingenieria.usac.edu.gt
      - CORE_PEER_ADDRESS=peer0.ingenieria.usac.edu.gt:7051
      - CORE_PEER_LISTENADDRESS=0.0.0.0:7051
      - CORE_PEER_CHAINCODEADDRESS=peer0.ingenieria.usac.edu.gt:7052
      - CORE_PEER_CHAINCODELISTENADDRESS=0.0.0.0:7052
      - CORE_PEER_GOSSIP_BOOTSTRAP=peer0.ingenieria.usac.edu.gt:7051
      - CORE_PEER_GOSSIP_EXTERNALENDPOINT=peer0.ingenieria.usac.edu.gt:7051
      - CORE_PEER_LOCALMSPID=IngenieriaMSP

      - CORE_LEDGER_STATE_STATEDATABASE=CouchDB
      - CORE_LEDGER_STATE_COUCHDBCONFIG_COUCHDBADDRESS=couchdb0:5984
      - CORE_LEDGER_STATE_COUCHDBCONFIG_USERNAME=admin
      - CORE_LEDGER_STATE_COUCHDBCONFIG_PASSWORD=adminpw

    working_dir: /opt/gopath/src/github.com/hyperledger/fabric/peer
    command: peer node start
    volumes:
      - /var/run/docker.sock:/host/var/run/docker.sock
      - ./crypto-config/peerOrganizations/ingenieria.usac.edu.gt/peers/peer0.ingenieria.usac.edu.gt/msp:/etc/hyperledger/fabric/msp
      - ../chaincode:/opt/gopath/src/github.com/chaincode
      - peer0.ingenieria.usac.edu.gt:/var/hyperledger/production
    ports:
      - "7051:7051"
    depends_on:
      - couchdb0
      - orderer.usac.edu.gt
    networks:
      - red-usac
  
  # 4. Nodo de Almacenamiento Distribuido (IPFS)
  ipfs_node:
    container_name: ipfs_node
    image: ipfs/kubo:v0.22.0
    environment:
      - IPFS_PATH=/data/ipfs
    ports:
      - "4001:4001" # IPFS Swarm
      - "5001:5001" # IPFS API REST Gateway
      - "8080:8080" # IPFS Gateway Público
    volumes:
      - ipfs_data:/data/ipfs
    networks:
      - red-usac
